rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.preferredLiftUrl is string && data.preferredLiftUrl.size() >= 1 && data.preferredLiftUrl.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSavedLiftMedia(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
             data.sourcePageUrl is string && data.sourcePageUrl.size() >= 1 && data.sourcePageUrl.size() <= 600 &&
             (!('streamUrl' in data) || data.streamUrl == null || (data.streamUrl is string && data.streamUrl.size() <= 1000)) &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 600)) &&
             data.sourceDomain is string && data.sourceDomain.size() >= 1 && data.sourceDomain.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWatchRoom(data) {
      return data.hostId is string && data.hostId.size() >= 1 && data.hostId.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 50 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.sourcePageUrl is string && data.sourcePageUrl.size() >= 1 && data.sourcePageUrl.size() <= 600 &&
             data.streamUrl is string && data.streamUrl.size() >= 1 && data.streamUrl.size() <= 1000 &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 600)) &&
             data.sourceDomain is string && data.sourceDomain.size() >= 1 && data.sourceDomain.size() <= 120 &&
             data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 12 &&
             data.isPublic is bool &&
             data.status in ['active', 'ended'] &&
             data.isPlaying is bool &&
             data.playbackPositionMs is int && data.playbackPositionMs >= 0 &&
             (data.playbackRate is float || data.playbackRate is int) && data.playbackRate >= 0.25 && data.playbackRate <= 4.0 &&
             data.syncVersion is int && data.syncVersion >= 0 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoomMessage(data) {
      return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 50 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 400 &&
             (!('reactionEmoji' in data) || data.reactionEmoji == null || (data.reactionEmoji is string && data.reactionEmoji.size() <= 16)) &&
             data.messageType in ['chat', 'reaction', 'system'] &&
             data.isPublic is bool &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 25 &&
             data.memberUids[0] is string &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. User Profiles (strict owner isolation)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'preferredLiftUrl', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'photoUrl', 'preferredLiftUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'preferredLiftUrl', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // 2. Saved Lift Media (user-scoped subcollection)
      match /saved_media/{mediaId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(mediaId) && request.auth.uid == userId;
        allow list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(mediaId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'title', 'sourcePageUrl', 'sourceDomain', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'description', 'sourcePageUrl', 'streamUrl', 'thumbnailUrl', 'sourceDomain', 'createdAt', 'updatedAt']) &&
                         isValidSavedLiftMedia(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(mediaId) &&
                         request.auth.uid == userId &&
                         isValidSavedLiftMedia(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'sourcePageUrl', 'streamUrl', 'thumbnailUrl', 'sourceDomain', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(mediaId) && request.auth.uid == userId;
      }
    }

    // 3. Watch Party Rooms
    match /watch_rooms/{roomId} {
      allow get: if isSignedIn() &&
                    isValidId(roomId) &&
                    (resource.data.isPublic == true ||
                     request.auth.uid in resource.data.memberUids ||
                     resource.data.hostId == request.auth.uid);

      allow list: if isSignedIn() &&
                     ((resource.data.isPublic == true && resource.data.status == 'active') ||
                      request.auth.uid in resource.data.memberUids);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       incoming().hostId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().memberUids.size() == 1 &&
                       incoming().status == 'active' &&
                       incoming().keys().hasAll([
                         'hostId', 'hostName', 'title', 'sourcePageUrl', 'streamUrl',
                         'sourceDomain', 'roomCode', 'isPublic', 'status',
                         'isPlaying', 'playbackPositionMs', 'playbackRate', 'syncVersion',
                         'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'hostId', 'hostName', 'title', 'sourcePageUrl', 'streamUrl',
                         'thumbnailUrl', 'sourceDomain', 'roomCode', 'isPublic', 'status',
                         'isPlaying', 'playbackPositionMs', 'playbackRate', 'syncVersion',
                         'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidWatchRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidWatchRoom(incoming()) &&
                       existing().status != 'ended' &&
                       incoming().hostId == existing().hostId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Host controls playback, metadata, visibility, or ends room
                         (
                           request.auth.uid == existing().hostId &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'title', 'sourcePageUrl', 'streamUrl', 'thumbnailUrl',
                             'isPublic', 'status', 'isPlaying', 'playbackPositionMs',
                             'playbackRate', 'syncVersion', 'updatedAt'
                           ])
                         ) ||
                         // Action 2: Authenticated user joins an active room (if public)
                         (
                           existing().isPublic == true &&
                           !(request.auth.uid in existing().memberUids) &&
                           request.auth.uid in incoming().memberUids &&
                           incoming().memberUids.hasAll(existing().memberUids) &&
                           incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                         ) ||
                         // Action 3: Member (not host) leaves the room
                         (
                           request.auth.uid != existing().hostId &&
                           request.auth.uid in existing().memberUids &&
                           !(request.auth.uid in incoming().memberUids) &&
                           existing().memberUids.hasAll(incoming().memberUids) &&
                           incoming().memberUids.size() == existing().memberUids.size() - 1 &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() &&
                       isValidId(roomId) &&
                       resource.data.hostId == request.auth.uid;

      // 4. Watch Party Messages (append-only subcollection)
      match /messages/{messageId} {
        allow get: if isSignedIn() &&
                      isValidId(roomId) &&
                      isValidId(messageId) &&
                      (resource.data.isPublic == true ||
                       request.auth.uid in resource.data.memberUids);

        allow list: if isSignedIn() &&
                       isValidId(roomId) &&
                       (resource.data.isPublic == true ||
                        request.auth.uid in resource.data.memberUids);

        allow create: if isSignedIn() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().roomId == roomId &&
                         incoming().senderId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'roomId', 'senderId', 'senderName', 'text',
                           'messageType', 'isPublic', 'memberUids', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'roomId', 'senderId', 'senderName', 'text', 'reactionEmoji',
                           'messageType', 'isPublic', 'memberUids', 'createdAt'
                         ]) &&
                         isValidRoomMessage(incoming()) &&
                         exists(/databases/$(database)/documents/watch_rooms/$(roomId)) &&
                         get(/databases/$(database)/documents/watch_rooms/$(roomId)).data.status == 'active' &&
                         get(/databases/$(database)/documents/watch_rooms/$(roomId)).data.isPublic == incoming().isPublic &&
                         request.auth.uid in get(/databases/$(database)/documents/watch_rooms/$(roomId)).data.memberUids;

        allow update, delete: if false;
      }
    }
  }
}
